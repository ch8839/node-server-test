NODE_ENV=development

# Server
SERVER_PORT=3100

# Database
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=          # ← 必填，本地数据库密码
DB_DATABASE=dev_local_db
DB_SSL=false          # ← TiDB Cloud 等云数据库需设为 true
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
# DATABASE_URL=       # ← 可选，设置后会覆盖上面的拼接结果
