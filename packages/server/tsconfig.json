{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@prisma/generated": ["./generated/prisma/client"]
    }
  },
  "include": ["src/**/*", "config/**/*", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
